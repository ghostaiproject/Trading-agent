# Anthropic API credentials (or run `ant auth login` instead of setting this)
ANTHROPIC_API_KEY=

# Interactive Brokers TWS / IB Gateway connection
# Ports: 7497 = TWS paper, 7496 = TWS live, 4002 = IB Gateway paper, 4001 = IB Gateway live
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=7

# 1 = live/real-time market data (requires a market data subscription), 3 = delayed (free)
MARKET_DATA_TYPE=3

# Comma-separated SYMBOL:CURRENCY:EXCHANGE:PRIMARY_EXCHANGE entries.
# Fields after the symbol are optional and default to CAD:SMART:TSE.
# Example mixing TSX and US-listed names:
WATCHLIST=SHOP:CAD:SMART:TSE,RY:CAD:SMART:TSE,AAPL:USD:SMART:NASDAQ

LLM_MODEL=claude-opus-5

# Risk limits (in account base currency)
MAX_ORDER_VALUE=2000
MAX_POSITION_VALUE=5000
MAX_DAILY_TRADES=5
MAX_TOTAL_EXPOSURE_PCT=50

# Safety switch: while true (the default), proposals still go through the LLM,
# risk checks, and human approval, but no order is ever sent to the broker.
# Set to false only once you've reviewed real behavior in a paper account.
DRY_RUN=true
